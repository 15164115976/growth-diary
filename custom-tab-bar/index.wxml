<view class="tabbar" style="padding-bottom:{{safeBottom}}px">
  <view class="tabbar-bg"></view>
  <view
    class="tab {{selected === index ? 'is-on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <view class="ico ico-{{item.icon}}">
      <view class="ico-a"></view>
      <view class="ico-b"></view>
      <view class="ico-c"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
