/* ================= 取景 ================= */
.stage {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  background: #0e120e;
  overflow: hidden;
}

.cam {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 参考底：虚化 + 提亮 + 降饱和，成为"浅色虚影" */
.ref {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  filter: blur(3px) saturate(0.4) brightness(1.32) contrast(0.86);
  transition: opacity 0.28s ease;
  pointer-events: none;
}

/* 三分线 */
.grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.gv {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 1rpx;
  background: rgba(255, 255, 255, 0.14);
}

.gv1 {
  left: 33.33%;
}

.gv2 {
  left: 66.66%;
}

.gh {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.14);
}

.gh1 {
  top: 33.33%;
}

.gh2 {
  top: 66.66%;
}

/* 对位四角 */
.corners {
  position: absolute;
  left: 10%;
  top: 16%;
  right: 10%;
  bottom: 26%;
  pointer-events: none;
}

.corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
}

.corner.tl {
  left: 0;
  top: 0;
  border-right: none;
  border-bottom: none;
  border-radius: 10rpx 0 0 0;
}

.corner.tr {
  right: 0;
  top: 0;
  border-left: none;
  border-bottom: none;
  border-radius: 0 10rpx 0 0;
}

.corner.bl {
  left: 0;
  bottom: 0;
  border-right: none;
  border-top: none;
  border-radius: 0 0 0 10rpx;
}

.corner.br {
  right: 0;
  bottom: 0;
  border-left: none;
  border-top: none;
  border-radius: 0 0 10rpx 0;
}

/* 顶部栏 */
.topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 28rpx 12rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 100%);
}

.tb-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  flex-shrink: 0;
}

.tb-btn:active {
  background: rgba(255, 255, 255, 0.28);
}

.tb-btn.on {
  background: #ffd66b;
}

.x {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.x::before,
.x::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}

.x::before {
  transform: rotate(45deg);
}

.x::after {
  transform: rotate(-45deg);
}

.tb-emoji {
  font-size: 30rpx;
}

.tb-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
  padding-top: 8rpx;
}

.tb-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.tb-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
  margin-top: 2rpx;
}

/* 参考提示 */
.ref-tip {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 26%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(14, 18, 14, 0.42);
  backdrop-filter: blur(8rpx);
  color: #fff;
  pointer-events: none;
}

.ref-tip.first {
  background: rgba(62, 124, 90, 0.36);
}

.ref-tip-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ref-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9fe4b8;
  animation: breathe 2s infinite;
}

.ref-tip-main {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.ref-tip-sub {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.68);
  text-align: center;
}

/* 底部控制 */
.dock {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding-top: 24rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.7) 46%, rgba(0, 0, 0, 0.92) 100%);
}

.dock-chips {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.chip-btn {
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.chip-btn.on {
  background: rgba(255, 255, 255, 0.92);
  color: #1f2a1f;
  font-weight: 600;
}

.dock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 56rpx;
}

.dock-btn {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.dock-ico {
  font-size: 40rpx;
}

.dock-label {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.62);
}

.shutter {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.12s ease;
}

.shutter:active {
  transform: scale(0.94);
}

.shutter-in {
  width: 118rpx;
  height: 118rpx;
  border-radius: 50%;
  background: #fff;
}

.shutter:active .shutter-in {
  background: #e9e9e9;
}

/* 相机不可用 */
.cam-fallback {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 80rpx;
  color: #fff;
}

.fb-ico {
  font-size: 80rpx;
  opacity: 0.6;
}

.fb-title {
  font-size: 30rpx;
  font-weight: 600;
}

.fb-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
  line-height: 1.6;
}

.fb-btn {
  margin-top: 20rpx;
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #1f2a1f;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.fb-btn.ghost {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  margin-top: 0;
}

/* ================= 确认 ================= */
.confirm {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
  background: #0e120e;
  display: flex;
  flex-direction: column;
}

.cf-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 28rpx 16rpx;
}

.cf-title {
  flex: 1;
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.cf-cmp-btn {
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 31rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  display: flex;
  align-items: center;
  white-space: nowrap;
}

.cf-cmp-btn.on {
  background: #fff;
  color: #1f2a1f;
  font-weight: 600;
}

.cf-cmp-ph {
  width: 130rpx;
}

.cf-stage {
  position: relative;
  flex: 1;
  margin: 0 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: #000;
}

.cf-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* 对比层：左侧显示上一次，宽度由 splitPos 控制 */
.cf-split {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
}

.cf-img-fixed {
  width: 750rpx;
  height: 100%;
}

.cf-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 16rpx rgba(0, 0, 0, 0.5);
}

.cf-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 68rpx;
  height: 68rpx;
  margin: -34rpx 0 0 -34rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
}

.knob-arrow {
  width: 12rpx;
  height: 12rpx;
  border-left: 3rpx solid #232a22;
  border-bottom: 3rpx solid #232a22;
}

.knob-arrow.l {
  transform: rotate(45deg);
}

.knob-arrow.r {
  transform: rotate(-135deg);
}

.cf-tag {
  position: absolute;
  top: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 19rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(6rpx);
}

.cf-tag.t-left {
  left: 20rpx;
}

.cf-tag.t-right {
  right: 20rpx;
}

.cf-body {
  padding: 24rpx 32rpx 0;
}

.cf-input {
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
}

.cf-ph {
  color: rgba(255, 255, 255, 0.36);
}

.cf-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.cf-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}

.cf-btn.primary {
  flex: 1.6;
  background: #fff;
  color: #1f2a1f;
}

.cf-btn.disabled {
  opacity: 0.6;
}

/* ================= 重力翻转与 Live 录制 ================= */
.viewport {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.rec-mask {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  z-index: 15;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 36rpx;
  border-radius: 26rpx;
  background: rgba(12, 16, 12, 0.66);
  backdrop-filter: blur(12rpx);
  animation: fadeIn 0.2s ease both;
}

.rec-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff5f56;
  animation: recPulse 1s ease-in-out infinite;
}

@keyframes recPulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.35;
    transform: scale(0.78);
  }
}

.rec-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.rec-sub {
  width: 100%;
  text-align: center;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.5);
}

.flip-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding-bottom: 16rpx;
}

.fh-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
}

.fh-dot.on {
  background: #7fd3a0;
  box-shadow: 0 0 10rpx rgba(127, 211, 160, 0.7);
}

.fh-text {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}

.fh-swap {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.72);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  margin-left: 2rpx;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 构图相似度 */
.cf-score {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 60rpx;
  padding: 0 22rpx;
  margin-bottom: 16rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
}

.cs-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
}

.cs-dot.good {
  background: #7fd3a0;
  box-shadow: 0 0 10rpx rgba(127, 211, 160, 0.8);
}

.cs-dot.mid {
  background: #e8c46a;
}

.cs-dot.low {
  background: #e5794f;
}

.cs-hint {
  margin-left: auto;
  color: rgba(255, 255, 255, 0.42);
}
