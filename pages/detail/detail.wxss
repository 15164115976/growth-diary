.page {
  min-height: 100vh;
  position: relative;
}

/* ---------- 返回 ---------- */
.hero-tools {
  position: absolute;
  left: 28rpx;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(12rpx);
}

.back:active {
  transform: scale(0.94);
}

.chev {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #232a22;
  border-bottom: 4rpx solid #232a22;
  transform: rotate(45deg);
  margin-left: -4rpx;
  border-radius: 2rpx;
}

/* ---------- 主视觉 ---------- */
.hero {
  position: relative;
  width: 100%;
  height: 580rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  animation: heroIn 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes heroIn {
  from {
    transform: scale(1.08);
    opacity: 0.6;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.hero-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-ghost {
  font-size: 300rpx;
  opacity: 0.22;
  transform: translate(90rpx, 40rpx);
}

.hero-grad {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 62%;
  background: linear-gradient(180deg, rgba(20, 26, 20, 0) 0%, rgba(20, 26, 20, 0.55) 62%, rgba(16, 22, 16, 0.82) 100%);
}

.hero-info {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 96rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  flex-shrink: 0;
}

.avatar:active {
  transform: scale(0.95);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 30rpx;
}

.avatar-emoji {
  font-size: 50rpx;
  line-height: 1;
}

.avatar-pen {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fff;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16);
}

.avatar-pen::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 2rpx;
  background: #3e7c5a;
  transform: rotate(45deg);
}

.hero-text {
  color: #fff;
  min-width: 0;
}

.hero-name {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.28);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 4rpx;
}

/* ---------- 数据条 ---------- */
.stats {
  position: relative;
  display: flex;
  align-items: center;
  margin: -64rpx 32rpx 0;
  padding: 26rpx 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 16rpx 40rpx rgba(46, 58, 44, 0.12);
  z-index: 5;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.stat-text {
  font-size: 28rpx;
}

.stat-label {
  font-size: 20rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--line);
}

/* ---------- 三个入口 ---------- */
.actions {
  display: flex;
  gap: 18rpx;
  padding: 28rpx 32rpx 0;
}

.action {
  flex: 1;
  border-radius: 30rpx;
  padding: 26rpx 18rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.16s ease;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(26rpx) saturate(170%);
  -webkit-backdrop-filter: blur(26rpx) saturate(170%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.95), 0 10rpx 30rpx rgba(46, 58, 44, 0.08);
}

.action:active {
  transform: scale(0.96);
}

.action-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 14rpx;
}

.action-name {
  font-size: 25rpx;
  font-weight: 600;
}

.action-desc {
  font-size: 19rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

/* ---------- 时间线 ---------- */
.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 46rpx 36rpx 20rpx;
}

.tl-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.tl-title {
  font-size: 32rpx;
  font-weight: 700;
}

.tl-count {
  font-size: 21rpx;
  color: var(--ink-3);
}

.tl {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 32rpx;
}

.tl-item {
  position: relative;
  width: 31.4%;
  padding-bottom: 31.4%;
  margin-bottom: 22rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--bg-deep);
  animation: fadeUp 0.4s ease both;
}

.tl-item:active {
  opacity: 0.88;
}

.tl-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.tl-badge {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.46);
  color: #fff;
  font-size: 17rpx;
  line-height: 1.5;
}

.tl-note {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 10rpx 8rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.6) 100%);
  color: #fff;
  font-size: 18rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  padding: 8rpx 0 0;
}

.tl-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 60rpx 60rpx;
}

.tl-empty-ico {
  font-size: 72rpx;
  opacity: 0.55;
}

.tl-empty-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.tl-empty-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
  text-align: center;
}

.tl-empty-btn {
  margin-top: 28rpx;
  height: 76rpx;
  padding: 0 48rpx;
  border-radius: 38rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

/* ---------- 底部操作栏 ---------- */
.bbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 32rpx 14rpx;
  background: rgba(255, 255, 255, 0.7);
  border-top: 1rpx solid rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(44rpx) saturate(180%);
  -webkit-backdrop-filter: blur(44rpx) saturate(180%);
  box-shadow: 0 -10rpx 36rpx rgba(46, 58, 44, 0.07);
  z-index: 40;
}

.bbar-side {
  width: 108rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.bbar-side:active {
  background: var(--bg-deep);
}

.bbar-ico {
  font-size: 30rpx;
  line-height: 1;
}

.bbar-text {
  font-size: 18rpx;
  color: var(--ink-2);
}

.bbar-main {
  flex: 1;
  height: 96rpx;
  border-radius: 26rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-shadow: 0 10rpx 26rpx rgba(62, 124, 90, 0.3);
}

.bbar-main:active {
  transform: scale(0.985);
}

.bbar-ring {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.92);
}

.bbar-main-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bbar-main-sub {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 30, 24, 0.42);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.22s ease both;
}

@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  width: 100%;
  background: rgba(250, 249, 245, 0.93);
  backdrop-filter: blur(50rpx) saturate(180%);
  -webkit-backdrop-filter: blur(50rpx) saturate(180%);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  padding: 18rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-sub {
  font-size: 21rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 6rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 28rpx 0 8rpx;
  /* 候选图标变多了，弹层内单独滚动，不把按钮顶出屏幕 */
  max-height: 42vh;
  overflow-y: auto;
}

.emoji-item {
  width: calc((100% - 64rpx) / 5);
  height: 104rpx;
  border-radius: 24rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.16s ease;
}

.emoji-item.on {
  background: var(--brand-soft);
  border-color: var(--brand);
}

.emoji-txt {
  font-size: 46rpx;
  line-height: 1;
}

.sheet-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  background: var(--bg);
  color: var(--ink-2);
}

.sheet-btn.primary {
  background: var(--brand);
  color: #fff;
}

/* ---------- Live 标识与播放 ---------- */
.tl-live {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

.tl-live-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #7fd3a0;
  animation: breathe 2.4s infinite;
}

.live-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.live-full {
  width: 100%;
  height: 78vh;
}

.live-close {
  margin-top: 24rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 2rpx;
}

/* ---------- 漂流瓶入口 ---------- */
.drift-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 32rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(27, 160, 150, 0.1) 0%, rgba(63, 134, 212, 0.1) 100%);
  border: 1rpx solid rgba(27, 160, 150, 0.16);
}

.drift-bar:active {
  opacity: 0.82;
}

.drift-bar.is-in {
  background: linear-gradient(135deg, rgba(27, 160, 150, 0.18) 0%, rgba(63, 134, 212, 0.14) 100%);
}

.drift-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.drift-ico {
  font-size: 40rpx;
}

.drift-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.drift-title {
  font-size: 26rpx;
  font-weight: 600;
}

.drift-sub {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* 投瓶弹层 */
.drift-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--bg);
  font-size: 25rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.drift-ph {
  color: var(--ink-3);
}

.drift-privacy {
  margin-top: 16rpx;
  font-size: 19rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

.pick-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid var(--ink-3);
  border-top: 3rpx solid var(--ink-3);
  transform: rotate(45deg);
  flex-shrink: 0;
}


/* ---------- 封面 LIVE 与换封面 ---------- */
.hero-live {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(0, 0, 0, 0.34);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.hero-live:active {
  transform: scale(0.95);
}

.hero-live.on {
  background: rgba(127, 211, 160, 0.92);
  border-color: transparent;
  color: #10402c;
}

.hl-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #fff;
}

.hero-live.on .hl-dot {
  background: #10402c;
  animation: breathe 1.4s infinite;
}

.cover-btn {
  position: absolute;
  right: 28rpx;
  z-index: 30;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(12rpx);
  display: flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #232a22;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.cover-btn:active {
  transform: scale(0.95);
}
