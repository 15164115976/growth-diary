.page {
  min-height: 100vh;
  position: relative;
}

.head {
  padding: 20rpx 36rpx 0;
}

.head-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.head-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  margin: 30rpx 32rpx 0;
  padding: 26rpx 0;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: var(--shadow);
}

.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.st-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand);
  line-height: 1.2;
}

.st-label {
  font-size: 20rpx;
  color: var(--ink-3);
}

.st-line {
  width: 1rpx;
  height: 40rpx;
  background: var(--line);
}

.list {
  padding: 30rpx 32rpx 0;
}

/* 左滑容器 */
.swipe {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: #fff;
}

.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
}

.sa {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #eef1ea;
  color: #3d4a3c;
}

.sa:active {
  opacity: 0.8;
}

.sa.danger {
  background: #fbe7e5;
  color: #b8395a;
}

.sa-ico {
  font-size: 30rpx;
  line-height: 1;
}

.sa-tx {
  font-size: 19rpx;
}

.item {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border-radius: 30rpx;
  padding: 20rpx;
  box-shadow: var(--shadow);
  transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.thumb-cover-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 16rpx;
  color: #fff;
  background: rgba(62, 124, 90, 0.9);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.thumb {
  position: relative;
  width: 168rpx;
  height: 200rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-emoji {
  font-size: 64rpx;
  opacity: 0.85;
}

.thumb-count {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 18rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.info-name {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.info-emoji {
  font-size: 28rpx;
}

.info-species {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meta-chip {
  font-size: 19rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-weight: 600;
}

.meta-last {
  font-size: 19rpx;
  color: var(--ink-3);
}

.play-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(62, 124, 90, 0.28);
}

.play-btn:active {
  transform: scale(0.94);
}

.play-tri {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-left: 22rpx solid #fff;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 60rpx 0;
}

.empty-ico {
  font-size: 90rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 10rpx;
  line-height: 1.7;
}

.empty-btn {
  margin-top: 36rpx;
  height: 84rpx;
  padding: 0 60rpx;
  border-radius: 42rpx;
  background: var(--brand);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.foot-tip {
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 20rpx;
}
