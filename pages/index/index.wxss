.page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

/* 顶部环境光 */
.glow-a {
  position: absolute;
  top: -240rpx;
  right: -180rpx;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(217, 123, 60, 0.16) 0%, rgba(217, 123, 60, 0) 70%);
  pointer-events: none;
}

.glow-b {
  position: absolute;
  top: 60rpx;
  left: -260rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(62, 124, 90, 0.14) 0%, rgba(62, 124, 90, 0) 70%);
  pointer-events: none;
}

/* ---------- 顶部 ---------- */
.topbar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 0;
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}

.brand-en {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
  font-weight: 500;
}

.subline {
  position: relative;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 20rpx 36rpx 8rpx;
}

.greeting {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}

.today {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* ---------- 继续观察 ---------- */
.hero {
  position: relative;
  margin: 24rpx 32rpx 8rpx;
  height: 456rpx;
  border-radius: 44rpx;
  overflow: hidden;
  box-shadow: var(--shadow-lift);
  background: #fff;
}

.hero:active {
  transform: scale(0.99);
}

.hero-media {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  animation: heroZoom 14s ease-out both;
}

@keyframes heroZoom {
  from {
    transform: scale(1.06);
  }
  to {
    transform: scale(1);
  }
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-ghost {
  font-size: 260rpx;
  opacity: 0.28;
  transform: translate(120rpx, -30rpx);
}

.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(24, 30, 24, 0.02) 0%, rgba(24, 30, 24, 0.12) 45%, rgba(18, 24, 18, 0.76) 100%);
}

.hero-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 36rpx 34rpx;
}

.on-dark {
  color: #fff;
}

.on-dark .hero-meta,
.on-dark .hero-last {
  color: rgba(255, 255, 255, 0.78);
}

.on-light {
  color: var(--ink);
}

.on-light .hero-meta,
.on-light .hero-last {
  color: var(--ink-2);
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.hero-tag {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
}

.on-light .hero-tag {
  background: rgba(255, 255, 255, 0.7);
  border-color: rgba(62, 124, 90, 0.16);
  color: var(--brand-deep);
}

.hero-day {
  font-size: 24rpx;
  opacity: 0.9;
  letter-spacing: 1rpx;
}

.hero-name {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.28;
}

.hero-meta {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.hero-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.hero-last {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
}

.pulse {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7fd3a0;
  box-shadow: 0 0 0 0 rgba(127, 211, 160, 0.6);
  animation: pulse 2.2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(127, 211, 160, 0.55);
  }
  70% {
    box-shadow: 0 0 0 14rpx rgba(127, 211, 160, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(127, 211, 160, 0);
  }
}

.shoot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.95);
  color: #1f2a1f;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.18);
}

.on-light .shoot {
  background: var(--brand);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(62, 124, 90, 0.3);
}

.shoot:active {
  transform: scale(0.96);
}

.shoot-ico {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 5rpx solid currentColor;
  opacity: 0.85;
}

/* ---------- 分组 ---------- */
.section {
  position: relative;
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 36rpx 4rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-sub {
  font-size: 22rpx;
  color: var(--ink-3);
}

.group {
  margin-top: 26rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx 16rpx;
}

.group-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
}

.group-name {
  font-size: 27rpx;
  font-weight: 600;
}

.group-hint {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-left: 4rpx;
}

.group-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(46, 58, 44, 0.06);
}

.group-add:active {
  background: #fff;
}

.group-add-ico {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1;
  margin-top: -2rpx;
}

/* 横向轨道 */
.rail {
  width: 100%;
  white-space: nowrap;
}

.rail-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 36rpx 12rpx;
}

.rec {
  width: 184rpx;
  flex-shrink: 0;
}

.rec:active {
  opacity: 0.86;
}

.rec-thumb {
  position: relative;
  width: 184rpx;
  height: 216rpx;
  border-radius: 26rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(46, 58, 44, 0.08);
}

.rec-img {
  width: 100%;
  height: 100%;
  display: block;
}

.rec-emoji {
  font-size: 72rpx;
  opacity: 0.85;
}

.rec-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  height: 32rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: rgba(62, 124, 90, 0.92);
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}

.rec-count {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 18rpx;
}

.rec-name {
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-sub {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.rec-new-box {
  width: 184rpx;
  height: 216rpx;
  border-radius: 26rpx;
  border: 2rpx dashed #d8d3c7;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.5);
}

.rec-new-plus {
  font-size: 44rpx;
  line-height: 1;
  opacity: 0.8;
}

.footer-tip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

/* ---------- 漂流瓶入口 ---------- */
.drift-entry {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 22rpx 32rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(27, 160, 150, 0.10) 0%, rgba(63, 134, 212, 0.10) 100%);
  border: 1rpx solid rgba(27, 160, 150, 0.14);
}

.drift-entry:active {
  opacity: 0.82;
}

.de-ico {
  font-size: 38rpx;
}

.de-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.de-title {
  font-size: 26rpx;
  font-weight: 600;
}

.de-sub {
  font-size: 20rpx;
  color: var(--ink-3);
}

.de-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid var(--ink-3);
  border-top: 3rpx solid var(--ink-3);
  transform: rotate(45deg);
}

/* ---------- 分类小笔 ---------- */
.cat-edit {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  color: var(--ink-3);
  margin-left: 4rpx;
}

.cat-edit:active {
  background: rgba(0, 0, 0, 0.1);
}

/* ---------- 拖动中的卡片 ---------- */
.rec.is-drag {
  transform: scale(1.07);
  opacity: 0.92;
  z-index: 10;
}

.rec.is-drag .rec-thumb {
  box-shadow: 0 16rpx 40rpx rgba(46, 58, 44, 0.28);
  outline: 3rpx solid var(--brand);
}

/* ---------- 分类编辑弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 30, 24, 0.44);
  z-index: 200;
  display: flex;
  align-items: flex-end;
  animation: maskIn 0.22s ease both;
}

@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  animation: sheetUp 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.sheet-bar {
  width: 68rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 0 auto 22rpx;
}

.sheet-title {
  font-size: 31rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-sub {
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 6rpx;
}

.sheet-input {
  height: 92rpx;
  border-radius: 22rpx;
  background: var(--bg);
  padding: 0 26rpx;
  font-size: 28rpx;
  margin-top: 22rpx;
  text-align: center;
  font-weight: 600;
}

.sheet-ph {
  color: var(--ink-3);
  font-weight: 400;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 22rpx 0 6rpx;
  max-height: 34vh;
  overflow-y: auto;
}

.emoji-item {
  width: calc((100% - 56rpx) / 5);
  height: 92rpx;
  border-radius: 22rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  border: 2rpx solid transparent;
}

.emoji-item.on {
  background: var(--brand-soft);
  border-color: var(--brand);
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  background: var(--bg);
  color: var(--ink-2);
}

.sheet-btn.primary {
  flex: 1.4;
  background: var(--brand);
  color: #fff;
}
